{
  "name": "mcp-survey-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "INPUT=mcp-app.html vite build && INPUT=web.html vite build",
    "build:mcp": "INPUT=mcp-app.html vite build",
    "build:web": "INPUT=web.html vite build",
    "serve": "tsx server.ts",
    "dev": "concurrently \"pnpm build:web -- --watch\" \"pnpm serve\"",
    "lint": "oxlint .",
    "format": "oxfmt ."
  },
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hono/node-server": "^2.0.2",
    "@hookform/resolvers": "^5.0.0",
    "@modelcontextprotocol/ext-apps": "^1.7.1",
    "@modelcontextprotocol/sdk": "^1.10.2",
    "hono": "^4.12.18",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "concurrently": "^9.1.2",
    "oxfmt": "^0.48.0",
    "oxlint": "^0.16.6",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
